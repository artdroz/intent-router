{
  "name": "intent-router",
  "version": "0.0.0",
  "private": true,
  "description": "Routing service for task classification.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/env": "^7.0.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.11.3",
    "fastify-plugin": "^6.0.0",
    "fastmcp": "^4.16.12",
    "pg": "^8.13.0",
    "pgvector": "^0.2.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.21.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.0",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.25.0",
    "vitest": "^3.2.6"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "check": "tsc --noEmit && eslint src/ && prettier --check 'src/**/*.{ts,json}'",
    "lint:fix": "eslint src/ --fix",
    "format:fix": "prettier --write 'src/**/*.{ts,json}'",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:prod": "tsx scripts/migrate.ts",
    "db:push": "drizzle-kit push",
    "create:tenant": "tsx scripts/create-tenant.ts",
    "evaluate": "bash evaluate/evaluator/run-all.sh"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
