# ---------------------------------------------------------------------------
# intent-router — local development configuration (Path A).
#
# Path A runs the app on the host (npm run dev) with Postgres in Docker and
# Ollama on the host. Copy this file to .env and it works as-is for the
# zero-key local setup:
#
#     cp .env.example .env
#
# Path B (everything in Docker) does NOT read this file — the same values are
# set inside docker-compose.yml for the `app` service.
# ---------------------------------------------------------------------------

# --- Server ----------------------------------------------------------------
PORT=8080                  # REST API (default)
MCP_PORT=8081              # MCP server, HTTP transport (default)
LOG_LEVEL=info             # pino log level: trace|debug|info|warn|error

# --- Database --------------------------------------------------------------
# Local Postgres from docker-compose.yml (postgres:postgres @ localhost:5432).
# This one URL is used by the app, the migration script, create-tenant and
# manage-keys. (A least-privilege migrate_user/app_user split exists in
# config/init-db.sql for real deployments; locally the superuser URL is fine.)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/intent-router

# --- Embedding (semantic stage) ---------------------------------------------
# Default: local Ollama. Any OpenAI-compatible /v1/embeddings endpoint works.
EMBED_BASE_URL=http://localhost:11434
EMBED_MODEL=nomic-embed-text
EMBED_DIMS=768             # optional; the built-in dims table already knows nomic = 768
EMBED_API_KEY=             # empty for Ollama; set for cloud endpoints

# --- LLM (final cascade stage) ----------------------------------------------
# Default: local Ollama. Any OpenAI-compatible /v1/chat/completions endpoint works.
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=               # empty for Ollama; set for cloud endpoints

# --- Lane B (LiteLLM / OpenAI-compatible surface) -----------------------------
# Required by env validation even if Lane B is never used. Any value works locally.
LITELLM_PROXY_TOKEN=dev-token
# When true, an unknown `intent-router-tenant` header auto-provisions the tenant
# instead of rejecting with 401. Used by the LiteLLM classifier plugin.
AUTO_CREATE_TENANT=false

# --- Config ------------------------------------------------------------------
DEFAULT_GATES_CONFIG_PATH=config/default-gates.yaml
MAX_PROMPT_LENGTH=50000

